{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faithful-core/contract/numeric_claim.schema.json",
  "title": "NumericClaim",
  "description": "An emitted number to verify: the string as rendered + its context + its proposed binding to a source Fact cell (directly or via a code-recomputed derivation). Consumers adapt their own claim objects into this shape.",
  "type": "object",
  "required": ["emitted", "binding", "context"],
  "properties": {
    "emitted": { "type": "string", "description": "the number exactly as rendered, e.g. \"$1.2B\", \"72%\", \"40 bps\"" },
    "context": {
      "type": "object",
      "description": "what the surrounding surface ASSERTS the number is about (best-effort).",
      "properties": {
        "surface": { "type": "string" },
        "label": { "type": "string" },
        "subject": { "type": "string" },
        "metric": { "type": "string" },
        "period": { "type": "string" },
        "basis": { "type": "string" }
      }
    },
    "binding": {
      "oneOf": [
        { "type": "object", "required": ["kind", "factId"],
          "properties": { "kind": { "const": "source" }, "factId": { "type": "string" } } },
        { "type": "object", "required": ["kind", "derivation"],
          "properties": { "kind": { "const": "derived" },
            "derivation": { "type": "object", "required": ["op", "operandFactIds"],
              "properties": {
                "op": { "enum": ["identity", "sum", "difference", "delta", "growth_pct", "share_of", "ratio", "product", "quotient", "annualize"] },
                "operandFactIds": { "type": "array", "items": { "type": "string" } } } } } },
        { "type": "object", "required": ["kind"],
          "properties": { "kind": { "const": "unbound" } } }
      ]
    }
  }
}
